{
  "expo": {
    "name": "Discipline",
    "slug": "discipline",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "discipline",
    "android": {
      "package": "com.moubine.discipline",
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "USE_EXACT_ALARM"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0f24"
      },
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#14c0e8"
        }
      ],
      "./plugins/withBgService.js"
    ],
    "icon": "./assets/icon.png",
    "newArchEnabled": false,
    "extra": {
      "eas": {
        "projectId": "30ef5639-7365-4ef1-80ac-40db124dd9b7"
      }
    },
    "owner": "moub2006"
  }
}
